# Email — required for contact/registration forms (/api/contact)
# Option A: Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# Optional: verified sender, e.g. ReaMed forma <forma@reamed.lt>
RESEND_FROM=

# Option B: SMTP fallback (used when Resend is unavailable)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password


# Online booking (/rezervacija) — the clinic system's website API. Without both the page
# says online booking is not available yet. The key is the shared secret klinika-website-api-key
# (Secret Manager, project reamed-site); never commit a real value.
KLINIKA_API_ORIGIN=https://klinika-986835987912.europe-north1.run.app
WEBSITE_API_KEY=
