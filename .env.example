# Email — required for contact/registration forms (/api/contact)
# Option A: Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# Optional: verified sender, e.g. ReaMed forma <forma@reamed.lt>
RESEND_FROM=

# Option B: SMTP fallback (used when Resend is unavailable)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password

